# ============================================================
# REQUIRED — App will not boot without these.
# See SETUP_SUPABASE.md for step-by-step instructions.
# ============================================================

# Supabase project (free tier at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# Session cookie signing key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-48-random-bytes

# ============================================================
# OPTIONAL — Features degrade gracefully if missing.
# ============================================================

# Google Maps JS API (legacy /api/places/google passthrough only)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# AI assistant (hidden in UI if both unset)
OPENAI_API_KEY=
GROQ_API_KEY=

# Email verification — Resend (https://resend.com, free 3k/mo).
# If unset, signup still works and verify links are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM=Smoking <noreply@yourdomain.com>

# Error tracking — Sentry. Inert if unset.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# FSQ Open Places parquet URL — bump when Foursquare releases a new snapshot.
# See https://opensource.foursquare.com/os-places/
FSQ_PARQUET_URL=

# Mapillary street-level imagery on the place detail page. Free.
# Token at https://www.mapillary.com/dashboard/developers
NEXT_PUBLIC_MAPILLARY_CLIENT_TOKEN=

# Force email verification before posting/claiming. If unset, gate auto-enables
# whenever RESEND_API_KEY is also set (i.e. production has email working).
# Set to "true" to force it on, "false" to force it off.
REQUIRE_EMAIL_VERIFIED=
