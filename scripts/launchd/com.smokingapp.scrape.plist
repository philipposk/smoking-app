<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.smokingapp.scrape</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd "/Users/phktistakis/Devoloper Projects/Smoking" &amp;&amp; npm run scrape:nightly</string>
  </array>

  <!-- Run every day at 03:00 local time. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- If the Mac was asleep at 03:00, fire as soon as it wakes. -->
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key>
  <string>/Users/phktistakis/Devoloper Projects/Smoking/scripts/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/phktistakis/Devoloper Projects/Smoking/scripts/logs/launchd.err.log</string>
</dict>
</plist>
